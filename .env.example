# Copy to backend/.env for local runs, or set these in the Railway
# dashboard (Settings > Variables) when hosting.

# Public URL of this deployment (Paystack redirects back here after payment).
APP_URL=http://localhost:8000

# Login-token signing key. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Paystack (card, bank account, bank transfer) -- dashboard.paystack.com
# Settings > API Keys & Webhooks. Start with sk_test_/pk_test_ keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
UPGRADE_AMOUNT_KOBO=250000

# Dev-only instant-upgrade bypass. MUST be false in production.
ALLOW_FREE_UPGRADE=true

# Optional: persistent sqlite path. On Railway, mount a volume at /data
# and set this so data survives redeploys:
# DATABASE_URL=sqlite:////data/metafile.db
